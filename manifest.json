{
  "manifest_version": 3,
  "name": "Pixel Pal – Healthy Habits Pet",
  "short_name": "Pixel Pal",
  "version": "1.1.0",
  "description": "A virtual pet that stays healthy when you do: drink water, stand up and rest your eyes to keep it alive.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pixel Pal",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/pet.js",
        "src/state.js",
        "src/sprite.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
